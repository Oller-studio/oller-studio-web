// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// From feature/checkout-lead-capture (not yet merged) — this table already
// exists on the shared dev database because that branch applied its
// migration directly. Model kept here just so this branch's migration
// history stays consistent with reality; the actual capture logic
// (app/api/checkout-lead, CheckoutForm changes) lives on that branch, not
// here — do not build against this model until that PR merges.
model CheckoutLead {
  id         String    @id @default(cuid())
  email      String    @unique
  items      String
  currency   String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
}

// Created PENDING the moment checkout starts (so we can see abandoned
// checkouts), then flipped to COMPLETED by the PayPal webhook — never by the
// browser — so "sales" reflects money that actually moved.
// Fulfillment stages for a handmade, built-to-order piece — tracks studio
// production, not just shipping.
// NEW_ORDER -> PRINTING -> PRINTED -> PACKED -> SENT -> DELIVERED
model Order {
  id                String      @id @default(cuid())
  paypalOrderId     String      @unique
  captureId         String?     @unique
  status            String
  amountCents       Int
  refundedCents     Int         @default(0)
  currency          String
  payerEmail        String?
  payerName         String?
  payerCountry      String?
  paypalFeeCents    Int         @default(0)
  shippingName      String?
  shippingAddress   String?
  shippingCity      String?
  source            String?
  // Same coarse bucket as PageView.channel — powers "Sales attributed to
  // marketing" on the Analytics dashboard.
  channel           String?
  // "Desktop" | "Mobile" | "Tablet" — same classifyDevice() sniff as
  // PageView.device, captured at checkout start.
  device            String?
  // Human-readable label from PayPal's payment_source ("PayPal", "Card",
  // "Venmo", "Apple Pay"...) — null for orders placed before this was added.
  paymentMethod     String?
  fulfillmentStatus String      @default("NEW_ORDER")
  startedPrintingAt DateTime?
  rawPayload        String?
  createdAt         DateTime    @default(now())
  completedAt       DateTime?
  refundedAt        DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  // Timestamp of the last abandoned-checkout email sent (any step) — used
  // both as the cron's guard against re-sending the same step twice, and
  // by the recovery metric (an order completed after this timestamp counts
  // as recovered by the sequence).
  abandonedEmailSentAt DateTime?
  // 0 = nothing sent yet, 1 = Reminder sent, 2 = Emotional Reminder sent,
  // 3 = Final Reminder sent. The cron only ever moves this forward by one
  // step at a time, and only for orders still not completed — a completed
  // order simply stops matching the cron's query, ending the sequence.
  abandonedEmailStep   Int       @default(0)
  items             OrderItem[]
}

// Captured the moment a checkout visitor types a valid email — before they
// ever click a payment button. Order rows only get created once someone
// actually starts a real PayPal transaction (see Order's own comment
// above), so without this, anyone who fills in their email/address but
// never clicks pay is completely invisible to us, with no way to follow
// up. Gets one soft nudge only (not the full 3-step Order sequence) — a
// colder signal deserves a lighter touch — and is skipped entirely once a
// matching real Order shows up for the same email, so nobody gets
// double-emailed.
model CheckoutLead {
  id         String    @id @default(cuid())
  email      String    @unique
  items      String
  currency   String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
}

model OrderItem {
  id              String @id @default(cuid())
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  colorwaySlug    String
  name            String
  quantity        Int
  unitAmountCents Int
}

// One row per browsing session (deduped via a 30-minute cookie in proxy.ts),
// not per page view — this is what "Sessions" on the dashboard counts.
model Visit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// One row per page load (storefront only), tagged with the session it
// belongs to and the first-touch source for that session — powers the
// Analytics dashboard's traffic sources, top pages, and top products.
model PageView {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  source    String?
  // Coarse bucket for source: "Direct" | "Ads" | "Social" | "Referral".
  channel   String?
  // "Desktop" | "Mobile" | "Tablet", sniffed from the User-Agent header.
  device    String?
  // From Vercel's edge geolocation headers — all null in local dev, since
  // those headers only exist once actually deployed on Vercel.
  country   String?
  region    String?
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
}

// One row per tracked interaction that isn't a page load — scrolling past
// the home hero, adding to the cart, etc. Feeds the funnel's steps that
// PageView alone can't answer. `name` is one of a small fixed set, see
// TRACKABLE_EVENTS in lib/track.ts.
model FunnelEvent {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name])
  @@index([sessionId])
}

// A bag model (ONDINE, ORBE, Object 01...) — name, price, and lead time are
// shared by every variant underneath it. Editable from /admin/products.
model Product {
  slug          String     @id
  name          String
  description   String
  // Fallback price when a color/edition doesn't set its own priceCents —
  // editions are expected to set their own now, this is a safety net.
  basePriceCents Int       @default(0)
  // "Was X" price shown struck through next to Price for a sale/promo — has
  // no effect unless it's set higher than basePriceCents.
  compareAtPriceCents Int?
  // Pieces included in one listing at that price — 1 for a single bag, more
  // if it's ever sold as a set/pack. Unit price = basePriceCents / unitCount.
  unitCount     Int        @default(1)
  weightGrams   Int?
  heightCm      Float?
  widthCm       Float?
  depthCm       Float?
  sizeAndFitNote String?
  // Override for the "Composition and Care" storefront section — if unset,
  // the storefront shows a default generated from `material` instead.
  compositionCareNote String?
  // Override for "Delivery, Exchanges and Returns" — same text on every
  // product unless this specific one needs different terms.
  deliveryReturnsNote String?
  material      String?
  printMinutes  Int?
  currency      String     @default("USD")
  leadTimeMinDays Int
  leadTimeMaxDays Int
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  variants      Colorway[]
  packaging     Packaging? @relation(fields: [packagingId], references: [id], onDelete: SetNull)
  packagingId   String?
}

// A reusable box/packaging preset (name + size) — set up once under
// Production, then picked per-product instead of typing dimensions each time.
model Packaging {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// One color/drop variant of a Product — what shows up as a shop listing.
// Editable from /admin/products/[slug]. Array/object fields (images,
// whyPoints, matchedCar, campaignNote) are stored as JSON strings, same
// pattern as Order.rawPayload.
model Colorway {
  slug                   String   @id
  product                Product  @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  productSlug            String
  name                   String
  // JSON array of hex colors, e.g. ["#8a4a3a"] or ["#d4af37","#e8a0bf"] for a
  // multi-color edition (rendered as a pie-slice swatch when there's more
  // than one) — up to 4 in the admin UI.
  swatchColors           String   @default("[]")
  // Overrides Product.basePriceCents for this specific color — null means
  // "use the product's price" (most colors won't need their own).
  priceCents             Int?
  // "Was X" price shown struck through next to Price for a sale/promo — has
  // no effect unless it's set higher than priceCents.
  compareAtPriceCents    Int?
  // Pieces included in one listing at that price — 1 for a single bag, more
  // if it's ever sold as a set/pack. Unit price = priceCents / unitCount.
  unitCount              Int      @default(1)
  compositionMaterial    String?
  compositionDescription String?
  tier                   String
  dropNumber             Int?
  dropEndsAt             String?
  totalPieces            Int?
  piecesRemaining        Int?
  images                 String   @default("[]")
  // Which of `images` shows on hover on shop cards/the homepage carousel —
  // independent of gallery order on the product page itself. Null falls
  // back to images[1] (the 2nd photo), same as before this existed.
  hoverImageUrl          String?
  matchedCarMake         String?
  matchedCarModel        String?
  matchedCarColorName    String?
  matchedCarImageUrl     String?
  matchedCarOwnerNote    String?
  story                  String?
  whyPoints              String   @default("[]")
  campaignQuote          String?
  campaignName           String?
  campaignRole           String?
  // Single source of truth for what customers see on the shop grid and
  // product page badge — "available" | "new" | "in_stock" | "coming_soon" |
  // "limited_edition" | "sold_out". Also drives whether Add to Bag is active
  // (everything except sold_out). Replaces what used to be spread across
  // availabilityStatus + a separate "mark as new" + "show stock" checkbox.
  shopBadge              String   @default("available")
  // Ready-to-ship pieces already sitting in the studio. When shopBadge is
  // "in_stock", this same number is what customers see too (e.g. "1 in
  // stock") — one number, so it goes down for real as it sells instead of
  // needing to be kept in sync by hand with a separate customer-facing count.
  stockOnHand            Int      @default(0)
  status                 String   @default("draft")
  isFeatured             Boolean  @default(false)
  // Null = no scheduled launch — a "coming_soon" badge just holds until
  // changed by hand. A real date schedules it: forces "coming_soon" until
  // that day, then auto-resolves to "available" (see lib/colorways.ts).
  launchedAt             String?
  sortOrder              Int      @default(0)
  // Overrides for the <title>/meta description Google shows for this
  // color's page — blank means fall back to an auto-generated one (see
  // lib/seo.ts). Independent of `name`/`story` so editing the on-page copy
  // doesn't silently change what search results say, and vice versa.
  seoTitle               String?
  seoDescription         String?
  // Every slug this color has ever had, oldest first — lets the product
  // page 301-redirect an old shared/bookmarked URL to wherever it lives now
  // instead of 404ing, whenever `slug` changes.
  previousSlugs          String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// What it costs to actually make one piece (materials only — print time is
// a product spec, see Product.printMinutes), entered by hand since there's
// no integration that can detect this. Keyed by colorway slug rather than a
// relation to keep cost-tracking independent of catalog edits.
model ProductCost {
  colorwaySlug String   @id
  name         String
  costCents    Int
  updatedAt    DateTime @updatedAt
}

// Recurring costs (rent, tools, subscriptions) — prorated by day when shown
// over a date range.
model FixedCost {
  id                 String    @id @default(cuid())
  label              String
  amountCentsPerMonth Int
  startDate          DateTime  @default(now())
  endDate            DateTime?
}

// The homepage's hero + editorial media — editable from Admin > Pages > Home
// instead of a developer swapping files under public/videos or
// public/images and redeploying. Singleton row (id is always "home"). Null
// fields fall back to the original file-drop convention in lib/media.ts, so
// nothing breaks until a piece is actually replaced from the admin page.
model HomePage {
  id            String   @id @default("home")
  heroVideoUrl  String?
  heroPosterUrl String?
  // JSON array of exactly 4 slots, in display order (left to right), each
  // either null (empty) or { type: "video" | "image", url }.
  editorial     String   @default("[]")
  updatedAt     DateTime @updatedAt
}

// "Notify me" signups left on a Sold Out color's page. Product/color name
// are stored directly (not a relation) so the list still reads fine even
// if that color is later renamed or removed — this is a record of demand,
// not something that should disappear with the catalog entry.
model WaitlistEntry {
  id           String    @id @default(cuid())
  colorwaySlug String
  colorName    String
  productName  String
  // Optional — rows created before this field existed have no name on file,
  // so sends fall back to a generic greeting for those.
  firstName    String?
  email        String
  // "notify" (default) = Limited Edition sold out or Coming Soon signup —
  // gets auto-emailed the Restock template the moment the colorway becomes
  // available. "print_request" = regular (non-numbered) print-on-demand
  // color that's sold out — gets an immediate confirmation + an internal
  // notification instead, and only gets the Restock email if an admin
  // decides to fulfill it manually from the Waitlist page.
  kind         String    @default("notify")
  // waiting -> invited (admin sent the private restock link) -> purchased
  // (matched to a completed order by email, see the PayPal webhook).
  status       String    @default("waiting")
  // Unguessable param that unlocks Add to Bag on this one color's page for
  // whoever holds the link, without changing the public Shop Badge.
  accessToken  String    @unique @default(cuid())
  invitedAt    DateTime?
  purchasedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([colorwaySlug, email])
  @@index([colorwaySlug])
}

// Editable copy for admin-triggered/automatic emails. {{variable}} tokens in
// subject/message get filled in per-send — buttons/links are always appended
// automatically, never editable here.
// `active` and `delayMinutes` only apply to time-delayed automations (e.g.
// abandoned checkout) — null for instant, event-triggered emails like
// order confirmation, which can't meaningfully be "delayed" or toggled off
// from here.
model EmailTemplate {
  id         String   @id @default(cuid())
  key        String   @unique
  subject    String
  message    String
  active     Boolean?
  delayMinutes Int?
  updatedAt  DateTime @updatedAt
}

// One row per email actually sent via Resend — capture only, no UI on this
// yet. `type` matches an EmailTemplate key ("order_confirmation", etc.) or
// a fixed string for the non-template sends ("welcome", "contact_inquiry",
// "collab_inquiry", "newsletter_signup"). Timestamps fill in as Resend's
// webhook reports delivery/opens/clicks — most rows will have nulls for a
// while, that's expected, not a bug.
model EmailLog {
  id          String    @id @default(cuid())
  resendId    String    @unique
  type        String
  to          String
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
}

// A referral, influencer, or collaborator (brand) partner. People use
// firstName+lastName; a Collaborator brand just uses firstName for its name
// and leaves lastName blank. Performance is computed live from PageView/
// Order rows matching each of its links' utmSource — nothing stored here.
// Their coupon code (if they have one) lives as its own Offer row instead
// of a bare string field, so it can carry a real discount value.
model Partner {
  id        String        @id @default(cuid())
  // "referral" | "influencer" | "collaborator"
  type      String
  firstName String
  lastName  String?
  // Inactive = collaboration ended, kept for history — their old link keeps
  // working (never break a link someone already shared), just deprioritized
  // in the admin list.
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  links     PartnerLink[]
  offers    Offer[]
}

// One tracked link per distribution channel for a partner — lets a partner
// active on both Instagram and TikTok get a separate link (and separate
// numbers) for each, instead of splitting them into two Partner rows.
model PartnerLink {
  id        String   @id @default(cuid())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String
  platform  String
  utmSource String   @unique
  createdAt DateTime @default(now())
}

// Reusable list of distribution channels (Organic, Instagram, TikTok…) a
// partner link can be tagged with — editable under Marketing, same pattern
// as Packaging presets under Production.
model DistributionChannel {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// A discount code — either standalone (a seasonal sale code) or tied to a
// partner (their personal coupon). Not applied at checkout yet — this is
// just the management layer; redeeming one still needs the checkout work.
model Offer {
  id        String   @id @default(cuid())
  code      String   @unique
  // "percentage" | "fixed"
  type      String
  // 10 for 10%, or a cents amount for "fixed".
  value     Int
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerId String?
  active    Boolean  @default(true)
  // Optional — null means it's usable right away. Same as `active`, not
  // enforced anywhere yet (no checkout redemption) — just tracked here so
  // the admin list can show "Scheduled" until this date arrives.
  startsAt  DateTime?
  // Optional — null means it never expires. Same as `active`, this isn't
  // enforced anywhere yet (no checkout redemption), just tracked here.
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

// Phase 1 of the Support inbox — every Contact form / Collab-with-us
// submission, so there's a record beyond just the email that went out.
// `resolved` is null until the customer answers the "did this answer your
// question?" poll (only sent for Order Status / Returns & Exchanges, the
// two subjects whose auto-reply actually contains a real answer) — true
// means they said yes, false means a human needs to follow up from the
// Support admin page, null covers both "no poll for this one" and "poll
// sent, no answer yet".
model Inquiry {
  id        String   @id @default(cuid())
  kind      String
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String?
  message   String
  resolved  Boolean?
  createdAt DateTime @default(now())
  messages  SupportMessage[]
  // Small fixed set (see TAGS in lib/inquiries.ts) — defaults from `kind`/
  // `subject` at creation, but always admin-editable from Support after.
  // Null on a raw inbound email means "not triaged yet".
  tag       String?
  // Unread until opened in Support, or bulk-marked — same idea as any
  // email client, independent of `resolved` (a read ticket can still be
  // unresolved, and vice versa).
  read      Boolean  @default(false)
  // Pinned for follow-up — its own sidebar view in Support, independent of
  // tag/resolved/read.
  starred   Boolean  @default(false)
}

// An email address marked spam from Support — future inbound emails from
// it are auto-tagged "spam" on arrival (see the webhook) instead of
// showing up untriaged. Un-spamming a ticket removes the sender from here
// too, so they're not silently stuck being auto-spammed after a correction.
model BlockedSender {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A real newsletter subscriber, captured from /api/newsletter-signup (the
// footer form and the checkout opt-in both hit that one route). Kept even
// after unsubscribing — with `unsubscribedAt` set — so re-signup just
// clears it instead of hitting the unique constraint, and so we never
// accidentally re-email someone who opted out.
model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  // Unguessable, used in the one-click unsubscribe link — not the row id,
  // so that alone can't be used to probe/enumerate subscriber rows.
  unsubscribeToken String    @unique @default(cuid())
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
}

// One row per email in a ticket's thread — the original submission (Contact
// form, Collab form, or a cold email that came straight to hello@) plus
// every reply after it, in and out. `direction` is "inbound" (from the
// customer, via the Resend inbound webhook or the original form submit) or
// "outbound" (sent from the admin's reply box). Lets /admin/support show a
// real conversation instead of just the first message.
model SupportMessage {
  id         String   @id @default(cuid())
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId  String
  direction  String
  fromEmail  String
  fromName   String?
  subject    String?
  body       String
  // Resend's id for this message — the outbound send id, or the inbound
  // email's id (used to de-duplicate if the webhook ever redelivers).
  resendId   String?  @unique
  createdAt  DateTime @default(now())

  @@index([inquiryId])
}
