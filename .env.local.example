NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENV=sandbox

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

ADMIN_EMAILS=

# Postgres connection string from Neon, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Transactional emails (restock, order confirmation, contact/collab/newsletter
# forms) — sending is skipped silently if unset, safe to leave blank in dev.
RESEND_API_KEY=

# Used to build absolute links in emails (tracking link, account link) —
# falls back to localhost if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
