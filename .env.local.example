NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENV=sandbox

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# "Continue with Google" — our own OAuth flow (not Clerk's hosted SSO, which
# needs Clerk's paid Production tier). From a Google Cloud OAuth 2.0 Client
# (Web application type); redirect URI must be
# <site>/api/auth/google/callback for both the local and production URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ADMIN_EMAILS=

# Postgres connection string from Neon, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Transactional emails (restock, order confirmation, contact/collab/newsletter
# forms) — sending is skipped silently if unset, safe to leave blank in dev.
RESEND_API_KEY=

# Signing secret for the Resend webhook (delivered/opened/clicked/bounced
# tracking) — from the Resend dashboard, Webhooks → this endpoint's secret,
# once the webhook is created there pointing at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# Used to build absolute links in emails (tracking link, account link) —
# falls back to localhost if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Shared secret for /api/cron/abandoned-checkout — whatever scheduler hits
# that endpoint (Vercel Cron, or an external pinger on Hobby plans) must send
# `Authorization: Bearer <this value>`. Pick any long random string.
CRON_SECRET=
